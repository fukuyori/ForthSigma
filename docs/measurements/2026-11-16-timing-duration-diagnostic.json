  "analysis_script": "from pathlib import Path\nimport json,statistics,hashlib\nr=Path.cwd();o=r/'.work/timing-duration-diagnostic-20261116';rows=json.loads((o/'samples.json').read_text());summary=[];audit=[]\nfor row in rows:\n a,b=row['queries']['queries'][:2];cpu=sum(b[k]-a[k] for k in ['kernel_ns','user_ns'])/1000;assert abs(cpu-row['cpu_us'])<1e-6\n t=sum(b['primary_thread'][k]-a['primary_thread'][k] for k in ['kernel_ns','user_ns'])/1000;audit.append({'series':row['series'],'round':row['round'],'condition':row['condition'],'warmup':row['warmup_excluded'],'logged_api_cpu_us':cpu,'reported_cpu_us':row['cpu_us'],'primary_thread_cpu_us':t,'process_minus_thread_us':cpu-t,'cpu_on_15_625_ms_grid':row['cpu_us']%15625==0})\nfor series in [1,2]:\n for condition in ['short','long']:\n  a=[x for x in rows if x['series']==series and x['condition']==condition and not x['warmup_excluded']];v=[x['cpu_us'] for x in a];median=statistics.median(v);summary.append({'series':series,'condition':condition,'cpu_median_us':median,'cpu_min_us':min(v),'cpu_max_us':max(v),'cpu_range_us':max(v)-min(v),'range_percent_of_median':100*(max(v)-min(v))/median,'wall_median_us':statistics.median(x['wall_us'] for x in a),'wall_excess_percent_of_cpu_median':100*(statistics.median(x['wall_us'] for x in a)/median-1)})\n(o/'audit-summary.json').write_text(json.dumps({'audit':audit,'summary':summary},indent=2)+'\\n');p=r/'docs/measurements/2026-11-16-timing-duration-diagnostic.json';x=json.loads(p.read_text());x['followup_consistency_audit']=audit;x['followup_summary']=summary;x['audit_scope']='API equality is self-consistency, not independent timing validation. Primary-thread readings are from a separate API but do not establish accounting accuracy.';p.write_text(json.dumps(x,indent=2)+'\\n');print('counted audits',sum(not x['warmup'] for x in audit),'max thread difference',max(abs(x['process_minus_thread_us']) for x in audit));print(summary)\n"
}
