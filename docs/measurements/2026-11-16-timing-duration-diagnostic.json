  "script": "from pathlib import Path\nimport sys,json,hashlib,statistics,importlib.util,os,ctypes,time,datetime\nfrom ctypes import wintypes\nroot=Path(__file__).resolve().parents[2];out=Path(__file__).resolve().parent\nspec=importlib.util.spec_from_file_location('benchmark',root/'scripts/benchmark-runtime.py');b=importlib.util.module_from_spec(spec);spec.loader.exec_module(b);b.cpu_affinity(0)\nbase=root/'zig-out/bin/sigma.exe'\nassert hashlib.sha256(base.read_bytes()).hexdigest()=='379d6c6c069b9c3072da22fa6cea8b7deff77c5ed78ef9bbd070f92a724337bf'\nassert hashlib.sha256((root/'scripts/benchmark-runtime.py').read_bytes()).hexdigest()=='576345f4486dd27a510327d91ec04d5f8ce9721f42059679bd78e4b661e315ef'\nimport _winapi\nprimary_by_pid={};original_create=_winapi.CreateProcess\ndef record_create(*args,**kwargs):\n result=original_create(*args,**kwargs);primary_by_pid[result[2]]=result[3];return result\n_winapi.CreateProcess=record_create\nclass ThreadEntry(ctypes.Structure):\n _fields_=[('dwSize',wintypes.DWORD),('cntUsage',wintypes.DWORD),('tid',wintypes.DWORD),('pid',wintypes.DWORD),('base',wintypes.LONG),('delta',wintypes.LONG),('flags',wintypes.DWORD)]\n\npids=[];sessions=[]\nclass Clock(b.WindowsProcessClock):\n def __init__(self,pid):\n  pids.append(pid);super().__init__(pid);self.queries=[];self.tid=primary_by_pid[pid]\n  self.api.OpenThread.argtypes=[wintypes.DWORD,wintypes.BOOL,wintypes.DWORD];self.api.OpenThread.restype=wintypes.HANDLE\n  self.api.GetThreadTimes.argtypes=[wintypes.HANDLE]+[ctypes.POINTER(wintypes.FILETIME)]*4;self.api.GetThreadTimes.restype=wintypes.BOOL\n  self.api.QueryThreadCycleTime.argtypes=[wintypes.HANDLE,ctypes.POINTER(ctypes.c_ulonglong)];self.api.QueryThreadCycleTime.restype=wintypes.BOOL\n  self.thread=self.api.OpenThread(0x0840,False,self.tid);self.thread_error=0 if self.thread else ctypes.get_last_error()\n  self.api.CreateToolhelp32Snapshot.argtypes=[wintypes.DWORD,wintypes.DWORD];self.api.CreateToolhelp32Snapshot.restype=wintypes.HANDLE\n  self.api.Thread32First.argtypes=[wintypes.HANDLE,ctypes.POINTER(ThreadEntry)];self.api.Thread32First.restype=wintypes.BOOL\n  self.api.Thread32Next.argtypes=[wintypes.HANDLE,ctypes.POINTER(ThreadEntry)];self.api.Thread32Next.restype=wintypes.BOOL\n  tids=[];snap=self.api.CreateToolhelp32Snapshot(4,0);snapshot_error=0\n  if snap==wintypes.HANDLE(-1).value:snapshot_error=ctypes.get_last_error()\n  else:\n   entry=ThreadEntry();entry.dwSize=ctypes.sizeof(entry);ok=self.api.Thread32First(snap,ctypes.byref(entry))\n   while ok:\n    if entry.pid==pid:tids.append(entry.tid)\n    entry.dwSize=ctypes.sizeof(entry);ok=self.api.Thread32Next(snap,ctypes.byref(entry))\n   self.api.CloseHandle(snap)\n  sessions.append({'pid':pid,'primary_tid_from_CreateProcess':self.tid,'thread_ids_at_READY':tids,'snapshot_error':snapshot_error,'primary_query_open_error':self.thread_error,'queries':self.queries})\n  self.api.QueryProcessCycleTime.argtypes=[wintypes.HANDLE,ctypes.POINTER(ctypes.c_ulonglong)];self.api.QueryProcessCycleTime.restype=wintypes.BOOL\n def read_ns(self):\n  fields=[wintypes.FILETIME() for _ in range(4)]\n  if not self.api.GetProcessTimes(self.handle,*(ctypes.byref(t) for t in fields)):raise ctypes.WinError(ctypes.get_last_error())\n  kernel=((fields[2].dwHighDateTime<<32)|fields[2].dwLowDateTime)*100;user=((fields[3].dwHighDateTime<<32)|fields[3].dwLowDateTime)*100\n  cycle=ctypes.c_ulonglong();ok=self.api.QueryProcessCycleTime(self.handle,ctypes.byref(cycle));err=0 if ok else ctypes.get_last_error()\n  thread_values=None\n  if self.thread:\n   t=[wintypes.FILETIME() for _ in range(4)];tok=self.api.GetThreadTimes(self.thread,*(ctypes.byref(v) for v in t));tc=ctypes.c_ulonglong();cok=self.api.QueryThreadCycleTime(self.thread,ctypes.byref(tc))\n   thread_values={'kernel_ns':((t[2].dwHighDateTime<<32)|t[2].dwLowDateTime)*100 if tok else None,'user_ns':((t[3].dwHighDateTime<<32)|t[3].dwLowDateTime)*100 if tok else None,'cycles':tc.value if cok else None,'time_query_ok':bool(tok),'cycle_query_ok':bool(cok)}\n  self.queries.append({'primary_thread':thread_values,'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'perf_counter_ns':time.perf_counter_ns(),'kernel_ns':kernel,'user_ns':user,'cycles':cycle.value if ok else None,'cycle_query_error':err})\n  return kernel+user\n def close(self):\n  if self.thread:self.api.CloseHandle(self.thread);self.thread=None\n  super().close()\nb.WindowsProcessClock=Clock\nprotocol=json.loads((out/'protocol.json').read_text());rows=[]\n(out/'start.json').write_text(json.dumps({'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'protocol_sha256':hashlib.sha256((out/'protocol.json').read_bytes()).hexdigest(),'script_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},indent=2)+'\\n')\nfor series in [1,2]:\n for round_id in range(4):\n  order=['short','long'] if (series+round_id)%2 else ['long','short']\n  for condition in order:\n   n=protocol['iterations'][condition];definition=protocol['definition'];source=f'{n} CONSTANT BENCH-ITERATIONS {definition} '+'.\" BENCH-READY\" CR KEY DROP BENCH-RUN .\" BENCH-DONE \" . CR KEY DROP BYE'\n   cpu,checksum,wall,total=b.sample(str(base),False,source);assert checksum==33*n\n   row={'series':series,'round':round_id,'condition':condition,'warmup_excluded':round_id==0,'iterations':n,'cpu_us':cpu,'wall_us':wall,'lifetime_cpu_us':total,'checksum':checksum,'queries':sessions[-1],'child_pid':pids[-1]};rows.append(row)\n   (out/'samples.json').write_text(json.dumps(rows,indent=2)+'\\n');print(series,round_id,condition,cpu,flush=True)\n(out/'complete.json').write_text(json.dumps({'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'counted_samples':12,'warmups':4,'baseline_only':True,'not_adoption':True},indent=2)+'\\n')\n",
