  "native_probe_source": "import sys,os,struct,time,json\nfrom pathlib import Path\nsys.path[:0]=['experiments','tests/scripts']\nfrom linux_x11_probe import Connection\nfrom linux_x11_test_support import SigmaSession\nc=Connection(os.environ['DISPLAY'])\nsrc='''REQUIRE-GRAPHICS ALSO GRAPHICS 160 100 GFX-INIT 640 400 WINDOW-SIZE DISPLAY-WINDOW SHOW\n: SNAP .\" STATE \" WINDOW-OPEN? . WINDOW-MINIMIZED? . WINDOW-FOCUSED? . WINDOW-PIXELS SWAP . . WINDOW-FRAMES SWAP . . CR ;\nSNAP KEY DROP 500 MS SNAP KEY DROP 500 MS SNAP 2000 WINDOW-PAINT-WAIT . CR WINDOW-CLOSE BYE'''\ndef children(w):\n h,b=c.reply(c.request(15,body=struct.pack('<I',w)));return list(struct.unpack('<'+'I'*(len(b)//4),b))\ndef find():\n todo=children(c.root)\n while todo:\n  w=todo.pop();h,b=c.reply(c.request(20,body=struct.pack('<IIIII',w,39,31,0,256)))\n  if b==b'FORTH/Sigma graphics':return w\n  todo.extend(children(w))\n raise AssertionError('window absent')\ntry:\n with SigmaSession(str(Path('zig-out/bin/sigma').resolve()),src,os.environ.copy()) as s:\n  before=s.line().decode();w=find()\n  event=struct.pack('<BBHII5I',33,32,0,w,c.atom(b'WM_CHANGE_STATE'),3,0,0,0,0)\n  c.request(25,body=struct.pack('<II',c.root,(1<<19)|(1<<20))+event);c.sync();time.sleep(.5);s.send()\n  minimized=s.line().decode()\n  event=struct.pack('<BBHII5I',33,32,0,w,c.atom(b'_NET_ACTIVE_WINDOW'),2,0,0,0,0)\n  c.request(25,body=struct.pack('<II',c.root,(1<<19)|(1<<20))+event);c.sync();time.sleep(.5);s.send()\n  restored=s.line().decode();paint=s.line().decode();s.finish()\n  result=dict(before=before,minimized=minimized,restored=restored,paint_wait=paint)\n  print(json.dumps(result));assert before.split()[2]=='0';assert minimized.split()[2]=='-1';assert restored.split()[2]=='0'\nfinally:c.sock.close()\n",
