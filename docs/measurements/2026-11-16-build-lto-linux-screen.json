  "script": "from pathlib import Path\nimport json,hashlib,subprocess,math,statistics,datetime,importlib.util\nroot=Path('/mnt/d/home/source/zig/forthz');out=root/'.work/build-optimization-20261116/linux-screen';base=root/'.work/build-optimization-20261116/linux-default/bin/sigma';candidate=root/'.work/build-optimization-20261116/linux-full/bin/sigma';protocol=json.loads((out/'protocol.json').read_text());sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();assert sha(base)==protocol['baseline_sha256'];assert sha(candidate)==protocol['candidate_sha256']\nspec=importlib.util.spec_from_file_location('bench',root/'scripts/benchmark-runtime.py');b=importlib.util.module_from_spec(spec);spec.loader.exec_module(b);affinity=b.cpu_affinity(0)\ndef expected(n):\n a,c,value=3,7,1\n while n:\n  if n&1:value=(a*value+c)&65535\n  c=(a*c+c)&65535;a=(a*a)&65535;n>>=1\n return value\n\ndef source(n):return f'{n} CONSTANT BENCH-ITERATIONS '+b.CASES['arithmetic']+' .\" BENCH-READY\" CR KEY DROP BENCH-RUN .\" BENCH-DONE \" . CR KEY DROP BYE'\ndef sample(binary,n):\n cpu,check,wall,total=b.sample(str(binary),False,source(n));assert check==expected(n),(check,expected(n),n);return {'cpu_us':cpu,'wall_us':wall,'lifetime_cpu_us':total,'checksum':check}\ndef save(name,x):(out/name).write_text(json.dumps(x,indent=2)+'\\n')\nsave('start.json',{'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'protocol_sha256':sha(out/'protocol.json'),'script_sha256':sha(Path(__file__)),'benchmark_sha256':sha(root/'scripts/benchmark-runtime.py'),'affinity':affinity})\npilot=sample(base,100000000);save('pilot.json',pilot);n=math.ceil(100000000*6000000/pilot['cpu_us']);save('config.json',{'iterations':n,'expected':expected(n),'definition':b.CASES['arithmetic']})\ndef group(stage,index,engines,rounds):\n values={k:[] for k in engines};warm={};orders=[]\n for i in range(rounds+1):\n  keys=list(engines);keys=keys if (i+index)%2 else keys[::-1];orders.append(keys)\n  for key in keys:\n   row=sample(engines[key],n)\n   if i:values[key].append(row)\n   else:warm[key]=row\n   save(f'{stage}-{index}-partial.json',{'samples':values,'warmups':warm,'orders':orders})\n med={k:statistics.median(v['cpu_us'] for v in vs) for k,vs in values.items()};x={'samples':values,'warmups_excluded':warm,'orders':orders,'medians_us':med};a,c=list(med.values());x['delta_percent']=100*abs(a-c)/min(a,c);x['change_percent']=100*(c/a-1);save(f'{stage}-{index}.json',x);return x\naa=[group('aa',i,{'A1':base,'A2':base},5) for i in [1,2]];delta=max(x['delta_percent'] for x in aa);minimum=min(v for x in aa for v in x['medians_us'].values());save('aa-decision.json',{'delta_percent':delta,'minimum_median_us':minimum});print('AA',delta,minimum,flush=True)\nif delta>2 or minimum<5000000:save('stop.json',{'reason':'calibration unresolved; no candidate timed; no retry'});raise SystemExit(0)\nab=[group('compare',i,{'baseline':base,'candidate':candidate},7) for i in [1,2]];changes=[x['change_percent'] for x in ab];passed=all(x<=-10 and -x>2*delta for x in changes);save('decision.json',{'changes_percent':changes,'delta_percent':delta,'integer_screen_passed':passed,'not_adopted':True,'remaining_cases_unmeasured':True});print('AB',changes,'screen',passed,flush=True)\nsave('complete.json',{'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'not_adopted':True})\n",
